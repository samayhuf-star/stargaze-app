{
  "expo": {
    "name": "Stargaze",
    "slug": "stargaze",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samay.stargaze",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070b1e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samay.stargaze"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Stargaze uses the camera to show the live sky behind the star map.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stargaze uses your location to work out which stars are above you."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Stargaze uses motion sensors to match the star map to where you point your phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#03050d",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "stargaze",
    "owner": "kroszs-team",
    "extra": {
      "eas": {
        "projectId": "0c2d74e9-045e-4171-813e-9912426a9c2c"
      }
    }
  }
}
